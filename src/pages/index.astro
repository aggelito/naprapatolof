---
const prices = [
  { label: 'Nybesök', time: '40 min', price: '750 kr' },
  { label: 'Återbesök', time: '30 min', price: '750 kr' },
];

const googleReviewUrl =
  'https://www.google.com/search?q=Olof+Lancing+Naprapat+Simrishamn';
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Olof Lancing, legitimerad naprapat i Simrishamn. Behandling på måndagar och torsdagar."
    />
    <title>Olof Lancing Naprapat i Simrishamn</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top">Olof Lancing</a>
      <nav aria-label="Huvudmeny">
        <a href="#behandling">Behandling</a>
        <a href="#priser">Priser</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <p class="eyebrow">Legitimerad naprapat · Simrishamn</p>
        <h1>Hjälp med smärta, stelhet och besvär i kroppen.</h1>
        <p class="intro">
          Hands-on behandling, tydliga råd och rehabövningar anpassade efter dig.
        </p>
        <a class="button" href="#kontakt">Kontakt och bokning</a>
      </section>

      <section id="behandling" class="section">
        <p class="eyebrow">Behandling</p>
        <div class="section-grid">
          <h2>En tydlig väg framåt.</h2>
          <div>
            <p>
              Olof behandlar bland annat besvär i rygg, nacke, käke, leder och muskler.
              Besöket omfattar undersökning, behandling och en plan för vad du kan göra
              själv.
            </p>
            <p class="note">
              Särskilt intresse för käkrelaterad nacksmärta, idrottsbesvär och
              överbelastning.
            </p>
          </div>
        </div>
      </section>

      <section id="priser" class="section">
        <p class="eyebrow">Priser</p>
        <div class="price-list">
          {prices.map((item) => (
            <article>
              <div>
                <h2>{item.label}</h2>
                <p>{item.time}</p>
              </div>
              <strong>{item.price}</strong>
            </article>
          ))}
        </div>
      </section>

      <section id="kontakt" class="section contact">
        <div>
          <p class="eyebrow">Simrishamn</p>
          <h2>Måndagar och torsdagar.</h2>
          <p>Öppettider 08–16. Bokning sker via telefon till en början.</p>
          <p class="note">Telefonnummer och bokningsuppgifter kommer snart.</p>
        </div>
        <div class="review">
          <p class="eyebrow">Google</p>
          <h2>Läs eller lämna ett omdöme.</h2>
          <a
            class="text-link"
            href={googleReviewUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Öppna Google-recensioner <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>

    <footer>
      <span>Olof Lancing · Legitimerad naprapat</span>
      <a href="#top">Till toppen</a>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f5f0df;
    --surface: #687956;
    --ink: #33382e;
    --muted: #656d60;
    --line: #d8d5c7;
    --accent: #62704d;
    --highlight: #c7b879;
    --on-accent: #fffaf0;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    border-top: 6px solid var(--highlight);
    background: var(--bg);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.55;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header,
  main,
  footer {
    width: min(1080px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  nav {
    display: flex;
    gap: 24px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  nav a:hover,
  footer a:hover,
  .text-link:hover {
    color: var(--accent);
  }

  .hero {
    max-width: 900px;
    padding: clamp(88px, 14vw, 170px) 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 18px;
    height: 3px;
    background: var(--highlight);
    content: '';
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 880px;
    margin-bottom: 28px;
    font-size: clamp(3rem, 8vw, 6.8rem);
    line-height: 0.96;
    letter-spacing: -0.075em;
  }

  h2 {
    margin-bottom: 10px;
    font-size: clamp(1.7rem, 4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
  }

  .intro {
    max-width: 660px;
    margin-bottom: 34px;
    color: var(--muted);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
  }

  .button:hover {
    background: var(--ink);
  }

  .section {
    padding: 80px 0;
    border-top: 1px solid var(--line);
  }

  .section-grid,
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 8vw, 100px);
  }

  .section-grid > div,
  .contact > div {
    max-width: 520px;
  }

  .section-grid p,
  .contact p {
    color: var(--muted);
    font-size: 1.06rem;
  }

  .note {
    font-size: 0.94rem !important;
  }

  .price-list {
    border-top: 1px solid var(--line);
  }

  .price-list article {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .price-list h2,
  .price-list p {
    margin-bottom: 0;
  }

  .price-list p {
    color: var(--muted);
  }

  .price-list strong {
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .review {
    padding: 36px;
    background: var(--surface);
    color: var(--on-accent);
  }

  .review .eyebrow {
    color: var(--on-accent);
  }

  .text-link {
    display: inline-block;
    margin-top: 14px;
    border-bottom: 1px solid currentColor;
    font-weight: 700;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 32px 0 48px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 680px) {
    .site-header,
    main,
    footer {
      width: min(100% - 28px, 1080px);
    }

    .site-header {
      align-items: flex-start;
    }

    nav {
      flex-direction: column;
      gap: 6px;
      text-align: right;
    }

    .hero {
      padding: 88px 0;
    }

    .section {
      padding: 56px 0;
    }

    .section-grid,
    .contact {
      grid-template-columns: 1fr;
    }

    .review {
      padding: 28px;
    }

    footer {
      flex-direction: column;
    }
  }
</style>
