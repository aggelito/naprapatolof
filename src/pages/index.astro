---
import { ArrowRight, CalendarDays, Clock3, ExternalLink, MapPin } from '@lucide/astro';
import '../styles/global.css';

const prices = [
  { label: 'Nybesök', time: '45 min', price: '750 kr' },
  { label: 'Återbesök', time: '30 min', price: '750 kr' },
  { label: 'Helgbesök', time: 'Efter överenskommelse', price: '1 000 kr' },
];

const careSteps = [
  {
    number: '01',
    title: 'Undersökning',
    text: 'Jag går igenom dina besvär och undersöker vad som påverkar smärta, stelhet eller rörelse.',
  },
  {
    number: '02',
    title: 'Behandling',
    text: 'Behandlingen individanpassas efter just din kropp och dina behov.',
  },
  {
    number: '03',
    title: 'Plan framåt',
    text: 'Du får tydliga råd och rehabövningar att använda inför och mellan besöken.',
  },
];

const googleReviewUrl =
  'https://www.google.com/search?q=Olof+Lancing+Naprapat+Simrishamn';
const bookingUrl = 'https://lancingab.bestille.no/OnCust2/#!/';
const locationMapUrl =
  'https://www.google.com/maps/search/?api=1&query=%C3%96sterlen%20Naprapaterna%2C%20Hamngatan%207%2C%20Simrishamn';
---

<html lang="sv" data-theme="olof-naprapati-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Jag är legitimerad naprapat och tar emot patienter på Österlen Naprapaterna, Hamngatan 7 i Simrishamn, på måndagar och torsdagar."
    />
    <meta name="theme-color" content="#f8f5ee" />
    <title>Olof Lancing Naprapat i Simrishamn</title>
    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://umami.aghost.io/script.js"
        data-website-id="4442e406-82a3-4337-b016-36153a8c4de6"
      ></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="site-container site-header__inner">
        <a class="brand" href="#top" aria-label="Olof Lancing, till sidans början">
          <span>Olof Lancing</span>
        </a>

        <nav class="site-nav" aria-label="Huvudmeny">
          <a class="btn btn-ghost btn-sm" href="#om-mig">Om mig</a>
          <a class="btn btn-ghost btn-sm" href="#behandling">Behandling</a>
          <a class="btn btn-ghost btn-sm" href="#priser">Priser</a>
          <a class="btn btn-ghost btn-sm" href="#kontakt">Kontakt</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="site-container hero__grid">
          <div class="hero__copy">
            <p class="eyebrow">Legitimerad naprapat · Simrishamn</p>
            <h1>Jag hjälper dig med smärta, stelhet och besvär i kroppen.</h1>
            <p class="intro">
              Jag erbjuder hands-on behandling, tydliga råd och rehabövningar anpassade efter dig.
            </p>
            <div class="hero__actions">
              <a
                class="btn btn-primary hero__booking"
                href={bookingUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Boka tid
                <ArrowRight class="size-5" aria-hidden="true" />
              </a>
              <a class="btn btn-ghost" href="#behandling">Så går det till</a>
            </div>
          </div>

          <div class="hero__side">
            <img
              class="hero__portrait"
              src="/olof-lancing.webp"
              alt="Olof Lancing ler och håller en kopp."
              width="1200"
              height="1200"
              fetchpriority="high"
            />

            <aside class="hero__facts" aria-label="Praktisk information">
              <dl>
                <div>
                  <CalendarDays class="size-5" aria-hidden="true" />
                  <span>
                    <dt>Dagar</dt>
                    <dd>Måndag och torsdag</dd>
                  </span>
                </div>
                <div>
                  <Clock3 class="size-5" aria-hidden="true" />
                  <span>
                    <dt>Öppettider</dt>
                    <dd>08:00–15:00</dd>
                  </span>
                </div>
                <div>
                  <MapPin class="size-5" aria-hidden="true" />
                  <span>
                    <dt>Plats</dt>
                    <dd>
                      <a
                        class="hero__location-link"
                        href={locationMapUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Öppna Österlen Naprapaterna i Google Maps"
                      >Österlen Naprapaterna</a><br />Hamngatan 7, Simrishamn
                    </dd>
                  </span>
                </div>
              </dl>
            </aside>
          </div>
        </div>
      </section>

      <section id="om-mig" class="section">
        <div class="site-container about">
          <div>
            <p class="eyebrow">Om mig</p>
            <h2>Jag heter Olof Lancing.</h2>
          </div>
          <div class="about__copy">
            <p>
              Jag är född och uppvuxen i Skillinge. Jag utbildade mig till naprapat 2020 och
              fick min legitimation 2021.
            </p>
            <p>
              De senaste sju åren har jag arbetat som naprapat i Malmö. Nu har jag valt att ta
              nästa steg och starta min egen klinik på hemmaplan.
            </p>
            <p>
              Hos mig möter du en lyhörd och engagerad naprapat som anpassar behandlingen efter
              just dina besvär och behov. Jag behandlar smärta och skador hos både unga och gamla
              – oavsett om du är idrottare, motionär eller soffpotatis.
            </p>
            <p>
              När jag inte arbetar tycker jag om att umgås med min familj. Jag gillar också
              löpträning, matlagning och att renovera på vårt hus.
            </p>
          </div>
        </div>
      </section>

      <section id="behandling" class="section section--sage">
        <div class="site-container">
          <div class="section-heading">
            <p class="eyebrow">Behandling</p>
            <h2>Så arbetar jag.</h2>
            <p>
              Jag behandlar bland annat besvär i rygg, nacke, käke, leder och muskler.
              Jag anpassar besöket efter vad du behöver hjälp med.
            </p>
          </div>

          <div class="care-steps">
            {careSteps.map((step) => (
              <article class="care-step">
                <span class="care-step__number" aria-hidden="true">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="site-container speciality">
          <div>
            <p class="eyebrow">Särskilt intresse</p>
            <h2>Det här intresserar mig särskilt.</h2>
          </div>
          <p class="speciality__statement">
            Käkrelaterad nacksmärta, idrottsbesvär och överbelastning.
          </p>
        </div>
      </section>

      <section id="priser" class="section section--sage">
        <div class="site-container">
          <div class="section-heading">
            <p class="eyebrow">Priser</p>
            <h2>Prislista</h2>
            <div class="payment-note">
              <img src="/swish.svg" alt="Swish" width="48" height="48" />
              <p>Hos mig betalar du via Swish.</p>
            </div>
          </div>
          <div class="price-list">
            {prices.map((item) => (
              <article class="price-row">
                <div>
                  <h3>{item.label}</h3>
                  <p>{item.time}</p>
                </div>
                <strong>{item.price}</strong>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="kontakt" class="contact-band">
        <div class="site-container contact-band__grid">
          <div>
            <p class="eyebrow">Kontakt och bokning</p>
            <h2>Ni är välkomna till mig i Simrishamn måndagar och torsdagar.</h2>
            <p>
              Du hittar mig på Österlen Naprapaterna, Hamngatan 7 i Simrishamn.
              Jag har öppet 08:00–15:00. Ring mig på&nbsp;<a
                href="tel:+46793256580">+46793256580</a
              > eller mejla mig på <a href="mailto:info@lancingnaprapati.se">info@lancingnaprapati.se</a>.
            </p>
          </div>

          <div>
            <p class="eyebrow">Google och Instagram</p>
            <a
              class="review-link"
              href={googleReviewUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Läs eller lämna ett omdöme</span>
              <ExternalLink class="size-5" aria-hidden="true" />
            </a>
            <a
              class="review-link"
              href="https://www.instagram.com/lancingnaprapati/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
              <span>@lancingnaprapati</span>
              <ExternalLink class="size-5" aria-hidden="true" />
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-container site-footer__inner">
        <p>Olof Lancing · Legitimerad naprapat</p>
        <a class="btn btn-ghost btn-sm" href="#top">Till toppen</a>
      </div>
    </footer>
  </body>
</html>
